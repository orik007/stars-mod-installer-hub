    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7785",
      "title": "Analyzer for wots6.com",
      "previous": {
        "modVersion": "1.1",
        "wotGameVersion": "2.3.1.0",
        "fileName": "s6wot-battle-reporter.wotmod",
        "updatedAt": "2026-08-01T18:28:56.096Z",
        "changeLog": ""
      },
      "current": {
        "modVersion": "1.2",
        "wotGameVersion": "2.3.1.1",
        "fileName": "s6WOT-pack.zip",
        "updatedAt": "2026-08-06T21:46:06.612Z",
        "changeLog": "Fixed: battles you left before the end are no longer missing. The mod now asks the game server for the result of every arena you entered and reports it once the battle is finalised.\n\nFixed: net credits were too high — auto-resupply of ammunition and consumables was not subtracted. Net credits now match the in-game battle results screen exactly.\n\nFixed: the same battle could appear twice when a platoon-mate ran an older version of the mod. Reports of the same battle are now merged into one record.\n\nAdded: battle start time is now sent with every record, so repeated short battles are never merged together.\n\nImproved: duplicate protection inside the mod — a battle captured by more than one path is reported only once."
      }
    },
