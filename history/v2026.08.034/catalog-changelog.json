    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7711",
      "title": "Camo Selector",
      "previous": {
        "modVersion": "2.3.0",
        "wotGameVersion": "2.3.1.1",
        "fileName": "gravity.camo_selector.2.3.1.1.2.3.0.wotmod",
        "updatedAt": "2026-08-09T23:06:52.568Z",
        "changeLog": "Major update: Creations & Asset Library\n\nAdded a new Creations system for saving, managing and sharing complete vehicle designs.\n\n* Save, apply, refresh and duplicate Creations.\n* Add titles, descriptions, tags and classifications.\n* Search and import approved public Creations.\n* Publish your own Creations for review.\n* Publish and import individual custom assets through the Asset Library.\n* Publish and import locked Vehicle Presets.\n\nCreations and Vehicle Presets can include the custom local assets they require. Imported assets are installed locally and automatically remapped to work on the receiving client.\n\nNothing is uploaded automatically. Local assets and Creations remain private unless explicitly published.\n\nVehicle Presets stay locked after import, but can be duplicated into editable local Creations.\n\nStyle Share remains separate and does not transfer local asset files.\n"
      },
      "current": {
        "modVersion": "2.3.1",
        "wotGameVersion": "2.3.1.2",
        "fileName": "gravity.camo_selector.2.3.1.2.2.3.1.wotmod",
        "updatedAt": "2026-08-11T18:41:46.019Z",
        "changeLog": "Bug Fixes and Improvements"
      }
