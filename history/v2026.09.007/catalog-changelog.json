    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7752",
      "title": "Overmatch.pro",
      "previous": {
        "modVersion": "1.5.1",
        "wotGameVersion": "2.3.1.3",
        "fileName": "overmatch_PwccP6n.zip",
        "updatedAt": "2026-08-25T07:20:32.569Z",
        "changeLog": "Your account now stays linked through modpack updates. Linking is also more reliable: you can use the clickable garage notification, and incompatible mods can no longer block the Link button. You can now choose which battle modes Overmatch uploads — Random Battles and Onslaught are enabled by default, while Special modes and Training Battles stay disabled until you enable them."
      },
      "current": {
        "modVersion": "1.5.2",
        "wotGameVersion": "2.4.0.0",
        "fileName": "overmatch_1QXUrUe.zip",
        "updatedAt": "2026-09-03T09:27:05.746Z",
        "changeLog": "Updated for World of Tanks 2.4. Fixed the game process sometimes staying open after you quit, especially on a fresh unlinked install. Overmatch now waits for you to click Link in the garage notification or mod settings instead of starting account linking automatically. Background checks and uploads no longer delay shutdown, and interrupted uploads retry the next time you play."
      }
    },
