  "changes": [
    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7783",
      "title": "ShotCaller",
      "previous": {
        "modVersion": "0.0.79",
        "wotGameVersion": "2.3.1.0",
        "fileName": "shotcaller_0.0.79.wotmod",
        "updatedAt": "2026-08-01T23:42:09.770Z",
        "changeLog": "Fixed missing WG application ID in release builds.\nAdded safe 8+7 chunking for 15-player rosters.\nAdded sequential requests and rate-limit retries.\nImproved failed-player recovery and stale-cache handling.\nLive-tested successfully in Advances."
      },
      "current": {
        "modVersion": "0.0.80",
        "wotGameVersion": "2.3.1.1",
        "fileName": "shotcaller_0.0.80.wotmod",
        "updatedAt": "2026-08-06T14:14:52.097Z",
        "changeLog": "Version 0.0.80\nAdded tank sorting by Name, Win Rate, or Battles within each tank type.\nAdded a minimum-battles filter to reduce rental and rarely played tanks.\nAdded collapsible tank-type sections with saved preferences.\nAdded clan-logo opacity controls and optional custom high-resolution clan logos.\nPreserved scroll position when sorting or collapsing sections.\nImproved history-window controls, logo loading, scaling, and responsiveness."
      }
    },
    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7745",
      "title": "14th_ua's MoE Calculator",
      "previous": {
        "modVersion": "1.8.0",
        "wotGameVersion": "2.3.1.0",
        "fileName": "MoECalculator_1.8.0.zip",
        "updatedAt": "2026-08-04T14:13:23.907Z",
        "changeLog": "Move the centre bar wherever you want. Ctrl+drag it mid-battle, with the bar on screen, and it stays there.\nHold Duration (s) under Transitions — how long the bar lingers before fading.\nAn ETA to your next mark on the Moving Average bar: its next-mark caption now also shows how many more battles you need at your current pace.\nThe Moving Average bar's lower end now follows your projected average instead of the mark you already hold.\nLarge is a more moderate step up from the default."
      },
      "current": {
        "modVersion": "2.0.0",
        "wotGameVersion": "2.3.1.1",
        "fileName": "MoECalculator_2.0.0.zip",
        "updatedAt": "2026-08-06T11:45:35.183Z",
        "changeLog": "Updated for 2.3.1.1."
      }
    },
    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7740",
      "title": "Garage Progress Bar",
      "previous": {
        "modVersion": "1.6.0",
        "wotGameVersion": "2.3.1.0",
        "fileName": "GarageProgressBar-Bundle_1.6.0.zip",
        "updatedAt": "2026-08-03T22:26:19.906Z",
        "changeLog": "The Fully Progressed tooltips now itemize what you finished. Hovering a category on the golden bar lists the actual items instead of just a total: every researched module and vehicle, each Field Modification level with the variant you picked, the skill tree's final upgrade, and each Elite Level reward with the level it unlocks at. Tier XI vehicles also get their skill counter in the tooltip header.\nNew \"Exclude Elite System\" setting. A child option under Fully Progressed, off by default. Turn it on and a vehicle whose only remaining progression is the Elite System grade band shows the golden Fully Progressed bar instead of the Elite bar. Unclaimed Elite rewards still take priority, so nothing you can still collect gets hidden."
      },
      "current": {
        "modVersion": "2.0.0",
        "wotGameVersion": "2.3.1.1",
        "fileName": "GarageProgressBar-Bundle_2.0.0.zip",
        "updatedAt": "2026-08-06T10:40:26.444Z",
        "changeLog": "Updated for 2.3.1.1."
      }
    },
