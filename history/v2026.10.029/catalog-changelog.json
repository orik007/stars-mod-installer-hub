    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7979",
      "title": "Gunmarks: Marks of Excellence",
      "previous": {
        "modVersion": "0.2.0",
        "wotGameVersion": "2.4.0.2",
        "fileName": "gunmarks_moe_0.2.0.37_wot2.4.0.2.zip",
        "updatedAt": "2026-10-06T11:47:58.923Z",
        "changeLog": "The mod is one file now, app.gunmarks.moe_0.2.0.wotmod, with its own version and updates: delete the old app.gunmarks.randoms_0.1.1.wotmod and, once every Gunmarks mod you have is updated, app.gunmarks.core_0.1.1.wotmod. Your settings and recorded battles are carried over.\nGarage panel: your moving average, what your last battle and your session did to the MoE, and a Goal section (the average damage to reach a mark in 10, 20 or 50 battles).\nMoE history: a page of its own with your recorded battles by tank and by session, a tank's MoE as a chart, and what each mark takes.\nBattle panel: your damage and assisted damage apart, green above your average; your average and each kind of assistance with Alt.\nSettings: a tab for each Gunmarks mod under its name; a switch for every line of both panels, with a preview of each.\nThe garage panel no longer stays on top of the equipment, shells and consumables screens."
      },
      "current": {
        "modVersion": "0.2.1",
        "wotGameVersion": "2.4.1.0",
        "fileName": "gunmarks_moe_0.2.1.38_wot2.4.1.0.zip",
        "updatedAt": "2026-10-14T14:26:52.214Z",
        "changeLog": ""
      }
    },
