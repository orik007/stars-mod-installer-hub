    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7977",
      "title": "Gunmarks: Role Skill charges",
      "previous": {
        "modVersion": "0.2.0",
        "wotGameVersion": "2.4.0.2",
        "fileName": "gunmarks_roleskills_0.2.0.37_wot2.4.0.2.zip",
        "updatedAt": "2026-10-06T11:48:02.291Z",
        "changeLog": "The mod is one file now, with its own version and its own updates. It no longer needs Gunmarks Core: once every Gunmarks mod you have is updated, delete app.gunmarks.core_0.1.1.wotmod.\nNew setting, Place: the Role Skills after the tank icon, or before it, between the tank's name and its icon.\nThe offset now goes from -400 to 400 px.\nThe preview shows the side panel in the size you use in battle, with a switch for its other sizes.\nThe settings page has a tab for each Gunmarks mod, under its name, and lists each with its own version.\nThe notice of a new version lists each of your mods that has one, with the version you have and the new one.\nThe garage panel no longer stays on top of the equipment, shells and consumables screens."
      },
      "current": {
        "modVersion": "0.2.1",
        "wotGameVersion": "2.4.1.0",
        "fileName": "gunmarks_roleskills_0.2.1.38_wot2.4.1.0.zip",
        "updatedAt": "2026-10-14T14:26:30.200Z",
        "changeLog": ""
      }
    },
