    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "5668",
      "title": "Classic's ZorGnome HRMOD Gun + Engine Sounds (Continuation of Zorgane's/Gnomefather's Historical Realism Sounds)",
      "previous": {
        "modVersion": "4.3.0",
        "wotGameVersion": "2.4.0.0",
        "fileName": "2.4.0.0_Classics_ZorGnome_HRMOD_GunsEngines_Sound_Mod_v4.3.0.zip",
        "updatedAt": "2026-09-01T16:59:33.952Z",
        "changeLog": "Added support for new T11s: WZ-219, Vz. 63P, CAV mod. 71, Ho-Ri Shugo, BV-111; added config + prefab overrides for new branch: Pz.Kpfw. 55, VPz 57, HWK 40, Kpz. 67, Pz. Neu; added configs for other new vehicles: BZ-75 Fireborn, Drills, AMX 29 Belier, VK 45.01 (P), Ironclad, NK-1; added prefab overrides for all double-gun vehicles (removed old configs); added configs for new Onslaught rentals; BP II firing sounds → match other 77 mm QF; WZ-114 reload → manual; fixed Chi-Go, KB-52, D.W. 2 firing sounds; Added 3 new engines: Fiat-Iveco V12 MTCA (CAV mod. 71), Kawasaki Type 98 (Chi-Ri, Chi-To SP, Ho-Ri 2 stock, Ka-Ri, Saryuda), Kawasaki Ha-9-IIb (Mitsu 108, Ju-Nu, Ju-To stock); reworked Kawasaki Type 98 x2 + new Kai variant (Type 4/5 Heavy); old Type 98 x2 → Aichi Ha-70 (Ho-Ri Shugo); fixes for Leyland L60 (Executor) + MT-50T; 107 mm 9S1 → single event (fixes dual playback); optimized 20 pdr & 75 mm rapid auto; shortened all two-stage 152 mm reloads (reduces perk restart issues)"
      },
      "current": {
        "modVersion": "4.3.0",
        "wotGameVersion": "2.4.0.0",
        "fileName": "2.4.0.0_Classics_ZorGnome_HRMOD_GunsEngines_Sound_Mod_v4.3.0.zip",
        "updatedAt": "2026-09-12T12:46:19.045Z",
        "changeLog": "Added support for new T11s: WZ-219, Vz. 63P, CAV mod. 71, Ho-Ri Shugo, BV-111; added config + prefab overrides for new branch: Pz.Kpfw. 55, VPz 57, HWK 40, Kpz. 67, Pz. Neu; added configs for other new vehicles: BZ-75 Fireborn, Drills, AMX 29 Belier, VK 45.01 (P), Ironclad, NK-1; added prefab overrides for all double-gun vehicles (removed old configs); added configs for new Onslaught rentals; BP II firing sounds → match other 77 mm QF; WZ-114 reload → manual; fixed Chi-Go, KB-52, D.W. 2 firing sounds; Added 3 new engines: Fiat-Iveco V12 MTCA (CAV mod. 71), Kawasaki Type 98 (Chi-Ri, Chi-To SP, Ho-Ri 2 stock, Ka-Ri, Saryuda), Kawasaki Ha-9-IIb (Mitsu 108, Ju-Nu, Ju-To stock); reworked Kawasaki Type 98 x2 + new Kai variant (Type 4/5 Heavy); old Type 98 x2 → Aichi Ha-70 (Ho-Ri Shugo); fixes for Leyland L60 (Executor) + MT-50T; 107 mm 9S1 → single event (fixes dual playback); optimized 20 pdr & 75 mm rapid auto; shortened all two-stage 152 mm reloads (reduces perk restart issues)"
      }
