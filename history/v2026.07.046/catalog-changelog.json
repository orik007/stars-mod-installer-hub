    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7745",
      "title": "14th_ua's MoE Calculator",
      "previous": {
        "modVersion": "1.3.0",
        "wotGameVersion": "2.3.1.0",
        "fileName": "MoECalculator_1.3.0.zip",
        "updatedAt": "2026-07-18T10:36:22.857Z",
        "changeLog": "Migrated to Aslain's ModsSettingsAPI dependency (from izeberg), and it ships bundled.\nRedesigned two-column settings panel — In-Battle controls are grouped under a single master toggle (with Show on Alt and Counted Assistance as sub-options), and the In-Garage widget has its own master toggle. The Alt behaviour is now a peek modifier over the master switch.\nLarger, more readable MoE award tooltip — bigger padding, icon, and description text."
      },
      "current": {
        "modVersion": "1.3.1",
        "wotGameVersion": "2.3.1.0",
        "fileName": "MoECalculator_1.3.1.zip",
        "updatedAt": "2026-07-20T08:53:50.132Z",
        "changeLog": "Build clean up."
      }
    },
