    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7783",
      "title": "ShotCaller",
      "previous": {
        "modVersion": "0.0.81",
        "wotGameVersion": "2.3.1.2",
        "fileName": "shotcaller_0.0.81.wotmod",
        "updatedAt": "2026-08-13T14:44:20.771Z",
        "changeLog": "Version 0.0.81\nImproved lookup recovery during temporary WG API failures.\nAdded clear Pending, Retrying, Ready, and Unavailable states.\nAdded retry countdown display without increasing API request frequency.\nHistory now refreshes automatically when recovery succeeds.\nFixed temporary failures incorrectly appearing as Missing.\nFixed lookup-status text clipping in the History window."
      },
      "current": {
        "modVersion": "0.0.83",
        "wotGameVersion": "2.3.1.3",
        "fileName": "shotcaller_0.0.83_F1P5hQt.wotmod",
        "updatedAt": "2026-08-27T10:40:48.303Z",
        "changeLog": "Added Training Room support for Team 1, Team 2, and Waiting players.\nAdded Observer/Spectator and Left-state handling.\nAdded mixed Tier VI, VIII, and X Training Room history lookup.\nPreserved Training Room navigation and cached history across player state changes.\nAdded support for unsupported-tier and no-tank states without treating them as lookup failures.\nImproved per-player Retry and Training Room roster reliability."
      }
    },
