    {
      "type": "added",
      "source": "wgmods",
      "sourceId": "7798",
      "title": "Hangar Carousel Classic",
      "previous": null,
      "current": {
        "modVersion": "1.0.5",
        "wotGameVersion": "2.3.1.2",
        "fileName": "hangar_carousel_classic_1.0.5_full_h5k23MB.zip",
        "updatedAt": "2026-08-13T15:16:13.771Z",
        "changeLog": "Fix native vehicle filtering so selected Classic filters are combined and applied to the carousel data source.\nShow all Classic filters directly in the native vanilla carousel filter popover, without a separate ModsSettingsAPI visibility setting.\nSynchronize active filter buttons through the Gameface view model so their selected state stays current after each toggle.\nRemove obsolete ModsSettingsAPI filter-visibility checkboxes.\nAdd a complete ZIP with Classic, ModsSettingsAPI, and OpenWG Gameface."
      }
    },
    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7781",
      "title": "WOT Tactic Bridge",
      "previous": {
        "modVersion": "0.2.2",
