  "changes": [
    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7745",
      "title": "14th_ua's MoE Calculator",
      "previous": {
        "modVersion": "0.3.0",
        "wotGameVersion": "2.3.0.1",
        "fileName": "MoECalculator_0.3.0.zip",
        "updatedAt": "2026-07-12T20:21:41.354Z",
        "changeLog": "Settings toggles — a new in-game settings panel (via ModsSettingsAPI) lets you enable or\ndisable the Garage widget and the in-battle widget independently.\nResolution-robust garage widget — the hangar percentile bar now anchors reliably and matches\nthe tank-card box height across screen resolutions and interface scales.\nNative-styled tooltip — the garage MoE award tooltip now reuses World of Tanks' own tooltip\nlook.\nIn-battle overlay tweak — small horizontal position adjustment to the live in-battle overlay.\nBundles the ModsSettingsAPI dependency (added automatically by the installer if missing)."
      },
      "current": {
        "modVersion": "1.0.0",
        "wotGameVersion": "2.3.1.0",
        "fileName": "MoECalculator_1.0.0.zip",
        "updatedAt": "2026-07-15T07:25:28.319Z",
        "changeLog": "World of Tanks 2.3.1.0 support — the mod is retargeted to the 2.3.1.0 client.\nBattle widget on Alt key — a new peek mode: keep the in-battle overlay hidden and show it\nonly while you hold Alt (opt-in via the settings panel).\nCounted Assistance row — an opt-in third row in the in-battle overlay showing the assistance\ndamage that counts toward your MoE."
      }
    },
