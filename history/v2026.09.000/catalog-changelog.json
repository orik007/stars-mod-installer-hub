      "title": "Vehicle Stat Inspector",
      "previous": {
        "modVersion": "1.0.3",
        "wotGameVersion": "2.3.1.3",
        "fileName": "gravity.vehicle_stat_inspector.2.3.1.3.1.0.3.zip",
        "updatedAt": "2026-08-31T17:49:24.695Z",
        "changeLog": "Added damage and penetration values for every available shell type. Added a shell selector to the main Firepower statistics. Average Damage, Average Penetration, and DPM now update for the selected shell, allowing statistics such as HE DPM to be viewed. Completed translations for all supported languages. Added a visible scrollbar and faster scrolling to the loadout sandbox.\nFixed hover tooltip text overlapping or wrapping incorrectly, particularly for magazine and container reload values. Preserved the compact single-line layout for normal statistics.\nImproved general interface layout and stability."
      },
      "current": {
        "modVersion": "1.0.4",
        "wotGameVersion": "2.4.0.0",
