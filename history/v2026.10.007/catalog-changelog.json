    {
      "type": "updated",
      "source": "wgmods",
      "sourceId": "7872",
      "title": "Evolved: Girls and Panzer Voice Selector (all voices)",
      "previous": {
        "modVersion": "2.4.0",
        "wotGameVersion": "2.4.0.1",
        "fileName": "Ver_2.4.0.zip",
        "updatedAt": "2026-09-25T07:19:36.280Z",
        "changeLog": "Bug Fix\n1. Fixed an issue where using the official subtitles could cause a drop in game performance.\nImprovement\n1. For all special crew members unrelated to Girls und Panzer, their additional voice lines—such as reloading voice lines and battlefield communication lines—have been changed from the Girls und Panzer versions back to the default versions to provide a more consistent overall experience."
      },
      "current": {
        "modVersion": "2.5.0",
        "wotGameVersion": "2.4.0.2",
        "fileName": "Ver_2.5.0.zip",
        "updatedAt": "2026-10-03T07:15:46.565Z",
        "changeLog": "Improvement\n1. Added a new Subtitle Selector to the GuP Voice Selector menu in the Garage. It provides nine subtitle language options, displayed using their native language names, as well as an Off option.\n All nine subtitle packs have now been merged into a single package. Your selected subtitle language is saved automatically and will take effect from the next battle. English is selected by default on first use."
      }
    },
